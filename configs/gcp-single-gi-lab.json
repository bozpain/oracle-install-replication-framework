{
  "run_id": "gcp-single-gi-lab",
  "install_type": "single-gi",
  "version": {
    "os_distribution": "oracle_linux",
    "os_version": "8.10",
    "oracle_version": "19c",
    "oracle_home_version": "19.0.0",
    "patch_set": "19.30"
  },
  "os": {
    "package_manager": "dnf",
    "preinstall_package": "oracle-database-preinstall-19c",
    "selinux_mode": "permissive",
    "ntp_servers": [
      "169.254.169.254"
    ]
  },
  "ssh": {
    "user": "rori_learning",
    "port": 22,
    "connect_timeout": 10,
    "strict_host_key_checking": "accept-new"
  },
  "dns": {
    "resolvers": [
      "169.254.169.254"
    ],
    "search_domains": [
      "asia-southeast2-a.c.project-938a6e28-56f9-4f95-bac.internal",
      "c.project-938a6e28-56f9-4f95-bac.internal",
      "google.internal"
    ]
  },
  "primary_site": {
    "name": "site-a",
    "db_name": "ORCL",
    "db_unique_name": "ORCL_A",
    "nodes": [
      {
        "host": "ora-primary-01",
        "public_ip": "10.184.0.3"
      }
    ]
  },
  "standby_site": {
    "name": "site-b",
    "db_unique_name": "ORCL_B",
    "nodes": [
      {
        "host": "ora-standby-01",
        "public_ip": "10.184.0.4"
      }
    ]
  },
  "asm": {
    "redundancy": "EXTERNAL",
    "data_disks": [
      {
        "site_paths": {
          "site-a": "/dev/disk/by-id/scsi-0Google_PersistentDisk_data-part2",
          "site-b": "/dev/disk/by-id/scsi-0Google_PersistentDisk_data2-part2"
        },
        "name": "DATA1"
      }
    ],
    "reco_disks": [
      {
        "site_paths": {
          "site-a": "/dev/disk/by-id/scsi-0Google_PersistentDisk_reco-part1",
          "site-b": "/dev/disk/by-id/scsi-0Google_PersistentDisk_reco2-part1"
        },
        "name": "RECO1"
      }
    ]
  },
  "installer": {
    "sources_path": "/u01/sources",
    "grid_zip": "LINUX.X64_193000_grid_home.zip",
    "db_zip": "LINUX.X64_193000_db_home.zip",
    "opatch_zip": "p6880880_190000_Linux-x86-64.zip",
    "grid_patch": {
      "name": "19.30 Grid RU",
      "type": "ru",
      "file": "p19_30_grid_ru_Linux-x86-64.zip"
    },
    "db_patch": {
      "name": "19.30 Database RU",
      "type": "ru",
      "file": "p19_30_db_ru_Linux-x86-64.zip"
    },
    "ojvm_patch": {
      "name": "19.30 OJVM RU",
      "type": "ojvm",
      "file": "p19_30_ojvm_ru_Linux-x86-64.zip"
    }
  },
  "dataguard": {
    "configuration_method": "broker",
    "protection_mode": "max_performance"
  },
  "secrets": {
    "sys_password_env": "ORACLE_AUTO_SYS_PASSWORD",
    "system_password_env": "ORACLE_AUTO_SYSTEM_PASSWORD",
    "asmsnmp_password_env": "ORACLE_AUTO_ASMSNMP_PASSWORD",
    "dg_password_env": "ORACLE_AUTO_DG_PASSWORD"
  }
}
