{
  "run_id": "single-gi-demo",
  "install_type": "single-gi",
  "version": {
    "os_distribution": "oracle_linux",
    "os_version": "8.10",
    "oracle_version": "19c",
    "oracle_home_version": "19.0.0",
    "patch_set": "19.30"
  },
  "os": {
    "package_manager": "dnf",
    "preinstall_package": "oracle-database-preinstall-19c",
    "selinux_mode": "permissive",
    "ntp_servers": [
      "192.168.113.41",
      "192.168.115.41"
    ]
  },
  "ssh": {
    "user": "root",
    "port": 22,
    "connect_timeout": 10,
    "strict_host_key_checking": "accept-new"
  },
  "dns": {
    "resolvers": [
      "192.168.113.10"
    ],
    "search_domains": [
      "example.com"
    ]
  },
  "primary_site": {
    "name": "site-a",
    "db_name": "ORCL",
    "db_unique_name": "ORCL_A",
    "nodes": [
      {
        "host": "db1-site-a.example.com",
        "public_ip": "192.168.113.101"
      }
    ]
  },
  "standby_site": {
    "name": "site-b",
    "db_unique_name": "ORCL_B",
    "nodes": [
      {
        "host": "db1-site-b.example.com",
        "public_ip": "192.168.115.101"
      }
    ]
  },
  "asm": {
    "redundancy": "EXTERNAL",
    "data_disks": [
      "360060e8008a3cf000050a3cf00000102"
    ],
    "reco_disks": [
      "360060e8008a3cf000050a3cf00000103"
    ]
  },
  "installer": {
    "sources_path": "/u01/sources",
    "patch_manifest": "19.30"
  },
  "dataguard": {
    "configuration_method": "broker"
  },
  "secrets": {
    "sys_password_env": "ORACLE_AUTO_SYS_PASSWORD",
    "system_password_env": "ORACLE_AUTO_SYSTEM_PASSWORD",
    "asmsnmp_password_env": "ORACLE_AUTO_ASMSNMP_PASSWORD",
    "dg_password_env": "ORACLE_AUTO_DG_PASSWORD"
  }
}
