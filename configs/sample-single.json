{
  "run_id": "single-primary-demo",
  "install_type": "single-db",
  "sources_path": "/u01/sources",
  "patch_version": "19.30",
  "os": {
    "distribution": "oracle_linux",
    "version": "8.10",
    "package_manager": "dnf",
    "preinstall_package": "oracle-database-preinstall-19c"
  },
  "ssh": {
    "user": "root",
    "port": 22,
    "connect_timeout": 10,
    "strict_host_key_checking": "accept-new"
  },
  "primary_site": {
    "name": "site-a",
    "nodes": [
      {
        "host": "db1-site-a.example.com"
      }
    ],
    "db_name": "ORCL",
    "db_unique_name": "ORCL_A"
  },
  "replication": {
    "enabled": false
  }
}
